{
  "id": "watchman-no-subscribers",
  "applies_to": [
    "process"
  ],
  "class": "advice",
  "verdict": "may-stop",
  "when": {
    "all": [
      {
        "fact": "catalog.id",
        "eq": "watchman"
      },
      {
        "fact": "watchman.subscriptions",
        "eq": 0
      },
      {
        "fact": "age_s",
        "gte": 3600
      }
    ]
  },
  "reason": {
    "vi": "Watchman đã chạy {age_s} mà không công cụ nào dùng tới nó.",
    "en": "Watchman has been running for {age_s} and no tool is using it."
  }
}
