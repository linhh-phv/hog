{
  "id": "launchd-restarts",
  "applies_to": [
    "process"
  ],
  "class": "advice",
  "verdict": "info",
  "when": {
    "all": [
      {
        "fact": "launchd.restarts_after_stop",
        "eq": true
      },
      {
        "fact": "footprint_bytes",
        "gte": 104857600
      },
      {
        "fact": "exe.system",
        "eq": false
      }
    ]
  },
  "reason": {
    "vi": "Nếu chỉ dừng, macOS sẽ tự bật lại nó.",
    "en": "If it is only stopped, macOS starts it again."
  }
}
