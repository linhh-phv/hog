#!/usr/bin/env bash
#
# lps - list & manage processes by listening port
# https://github.com/linhh-phv/lps

set -euo pipefail

VERSION="0.1.0"

# ---------- color (auto-disable when not a tty) ----------
if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
  C_DIM=$'\033[2m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_CYAN=$'\033[36m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
else
  C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_CYAN="" C_BOLD="" C_RESET=""
fi

# ---------- helpers ----------

# Best-effort project name resolution from a process cwd.
# Order: package.json#name → folder containing .git → basename(cwd) → "(system)" for system paths.
_resolve_project() {
  local pid="$1"
  local cwd
  cwd=$(_get_cwd "$pid")

  if [[ -z "$cwd" || "$cwd" == "/" ]]; then
    echo "(system)"
    return
  fi

  case "$cwd" in
    /System/*|/Library/*|/usr/*|/private/var/*|/Applications/*|/sbin/*|/bin/*)
      echo "(system)"
      return
      ;;
    */Library/Containers/*)
      echo "(system)"
      return
      ;;
  esac

  local dir="$cwd"
  while [[ "$dir" != "/" && -n "$dir" ]]; do
    if [[ -f "$dir/package.json" ]]; then
      local name
      name=$(grep -m1 '"name"' "$dir/package.json" 2>/dev/null \
        | sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
      if [[ -n "$name" ]]; then
        echo "$name"
        return
      fi
    fi
    if [[ -d "$dir/.git" ]]; then
      basename "$dir"
      return
    fi
    dir=$(dirname "$dir")
  done

  basename "$cwd"
}

_get_cwd() {
  # -a ANDs the filters; without it, lsof ORs and dumps cwd for every process.
  lsof -a -p "$1" -d cwd -Fn 2>/dev/null \
    | awk '/^n/ {print substr($0,2); exit}'
}

# An orphan here is a process whose parent died (PPID=1, reparented to launchd)
# AND that lives inside a user dir — i.e. a dev server whose terminal closed.
# Launchd-managed system daemons also have PPID=1 but are not "orphans".
_is_orphan() {
  local pid="$1"
  local ppid cwd
  ppid=$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d ' ')
  [[ "$ppid" == "1" ]] || return 1
  cwd=$(_get_cwd "$pid")
  [[ "$cwd" == /Users/* ]] || return 1
  case "$cwd" in
    */Library/Containers/*|*/.Trash/*) return 1 ;;
  esac
  return 0
}

# Emit "pid<TAB>port" lines for every LISTEN socket, deduped.
_listen_pairs() {
  lsof -iTCP -sTCP:LISTEN -P -n 2>/dev/null \
    | awk 'NR>1 {print $2 "\t" $9}' \
    | awk -F'\t' '{n=split($2,a,":"); print $1 "\t" a[n]}' \
    | sort -u
}

# Truncate a string to N chars, add ellipsis if cut.
_trunc() {
  local s="$1" n="$2"
  if [[ ${#s} -gt $n ]]; then
    echo "${s:0:$((n-1))}…"
  else
    echo "$s"
  fi
}

# ---------- commands ----------

cmd_list() {
  local only_orphans="${1:-}"

  printf "${C_BOLD}%-7s %-7s %-32s %-22s %s${C_RESET}\n" "PID" "PORT" "COMMAND" "PROJECT" "CWD"
  printf "${C_DIM}%s${C_RESET}\n" "----------------------------------------------------------------------------------------------------"

  local rows=""
  while IFS=$'\t' read -r pid port; do
    [[ -z "$pid" ]] && continue
    if [[ "$only_orphans" == "1" ]] && ! _is_orphan "$pid"; then
      continue
    fi

    local cmd project cwd cwd_display marker color
    cmd=$(ps -p "$pid" -o comm= 2>/dev/null | sed 's|.*/||')
    cmd=$(_trunc "$cmd" 32)
    project=$(_resolve_project "$pid")
    project=$(_trunc "$project" 22)
    cwd=$(_get_cwd "$pid")

    if _is_orphan "$pid"; then
      marker=" ${C_RED}[orphan]${C_RESET}"
      color="${C_YELLOW}"
    elif [[ "$project" == "(system)" ]]; then
      marker=""
      color="${C_DIM}"
    else
      marker=""
      color="${C_GREEN}"
    fi

    # For system processes the cwd is almost always "/" — show "—" instead.
    if [[ "$project" == "(system)" && ( "$cwd" == "/" || -z "$cwd" ) ]]; then
      cwd_display="—"
    else
      cwd_display="$cwd"
    fi

    rows+="$(printf "%-7s ${color}%-7s${C_RESET} %-32s ${C_CYAN}%-22s${C_RESET} ${C_DIM}%s${C_RESET}%s\n" \
      "$pid" "$port" "$cmd" "$project" "$cwd_display" "$marker")"$'\n'
  done < <(_listen_pairs)

  if [[ -z "$rows" ]]; then
    if [[ "$only_orphans" == "1" ]]; then
      echo "  ${C_GREEN}No orphan services running.${C_RESET}"
    else
      echo "  ${C_DIM}No services listening.${C_RESET}"
    fi
    return
  fi

  # Sort by port (numeric, column 2). Strip empty lines.
  echo -n "$rows" | awk -v RS='\n' 'NF' | sort -t' ' -k2,2n
}

cmd_orphans() {
  cmd_list 1
}

# Resolve a "target" string (port number or pid) to a list of PIDs.
_resolve_target() {
  local target="$1"
  local pids

  # Try as port first
  pids=$(lsof -ti tcp:"$target" -sTCP:LISTEN 2>/dev/null || true)
  if [[ -n "$pids" ]]; then
    echo "$pids"
    return 0
  fi

  # Try as PID
  if ps -p "$target" >/dev/null 2>&1; then
    echo "$target"
    return 0
  fi

  return 1
}

cmd_kill() {
  local force=0
  local target=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      -*) echo "${C_RED}Unknown flag: $1${C_RESET}" >&2; exit 2 ;;
      *) target="$1"; shift ;;
    esac
  done

  if [[ -z "$target" ]]; then
    _interactive_kill "$force"
    return
  fi

  local pids
  if ! pids=$(_resolve_target "$target"); then
    echo "${C_RED}No process found for: $target${C_RESET}" >&2
    exit 1
  fi

  _kill_pids "$force" $pids
}

_interactive_kill() {
  local force="$1"

  local pairs=()
  while IFS=$'\t' read -r pid port; do
    [[ -z "$pid" ]] && continue
    pairs+=("$pid"$'\t'"$port")
  done < <(_listen_pairs)

  if [[ ${#pairs[@]} -eq 0 ]]; then
    echo "${C_DIM}Nothing to kill.${C_RESET}"
    return
  fi

  local i=1
  for entry in "${pairs[@]}"; do
    local pid="${entry%%$'\t'*}"
    local port="${entry##*$'\t'}"
    local cmd project orphan_tag=""
    cmd=$(ps -p "$pid" -o comm= 2>/dev/null | sed 's|.*/||')
    project=$(_resolve_project "$pid")
    _is_orphan "$pid" && orphan_tag=" ${C_RED}[orphan]${C_RESET}"
    printf "  ${C_BOLD}%2d)${C_RESET} pid=%s port=${C_GREEN}%s${C_RESET}  %s  ${C_CYAN}%s${C_RESET}%s\n" \
      "$i" "$pid" "$port" "$cmd" "$project" "$orphan_tag"
    i=$((i+1))
  done

  echo
  printf "Pick number to kill (or q to quit): "
  read -r choice
  [[ "$choice" == "q" || -z "$choice" ]] && return

  if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#pairs[@]} )); then
    echo "${C_RED}Invalid choice.${C_RESET}" >&2
    exit 1
  fi

  local picked="${pairs[$((choice-1))]}"
  local pid="${picked%%$'\t'*}"
  _kill_pids "$force" "$pid"
}

_kill_pids() {
  local force="$1"; shift
  local pids=("$@")

  echo "${C_BOLD}About to kill:${C_RESET}"
  for pid in "${pids[@]}"; do
    local cmd project cwd
    cmd=$(ps -p "$pid" -o command= 2>/dev/null | cut -c1-80)
    project=$(_resolve_project "$pid")
    cwd=$(_get_cwd "$pid")
    printf "  pid=%s  ${C_CYAN}%s${C_RESET}\n    %s\n    ${C_DIM}%s${C_RESET}\n" \
      "$pid" "$project" "$cmd" "$cwd"
  done

  if [[ "$force" != "1" ]]; then
    echo
    printf "Confirm kill? [y/N] "
    read -r ans
    [[ "$ans" != "y" && "$ans" != "Y" ]] && { echo "Cancelled."; return; }
  fi

  for pid in "${pids[@]}"; do
    if kill "$pid" 2>/dev/null; then
      echo "${C_GREEN}✓${C_RESET} sent SIGTERM to $pid"
    else
      echo "${C_RED}✗${C_RESET} failed to kill $pid (try with sudo?)" >&2
    fi
  done

  # Give it a moment, then SIGKILL stragglers
  sleep 1
  for pid in "${pids[@]}"; do
    if ps -p "$pid" >/dev/null 2>&1; then
      if kill -9 "$pid" 2>/dev/null; then
        echo "${C_YELLOW}⚠${C_RESET} $pid still alive, sent SIGKILL"
      fi
    fi
  done
}

cmd_help() {
  cat <<EOF
${C_BOLD}lps${C_RESET} v$VERSION — list & manage processes by listening port

${C_BOLD}USAGE${C_RESET}
  lps                       List every process listening on a TCP port,
                            grouped by project.
  lps orphans               Only show orphan processes (PPID=1) — typically
                            dev servers whose terminal has died.
  lps kill <port|pid>       Kill the process listening on <port>, or the
                            given PID. Asks for confirmation.
  lps kill                  Interactive picker — choose by number.
  lps kill -f <port|pid>    Skip confirmation.
  lps version               Print version.
  lps help                  Show this help.

${C_BOLD}EXAMPLES${C_RESET}
  lps                       # see everything
  lps orphans               # see only the ghosts
  lps kill 3000             # nuke whatever's on :3000
  lps kill -f 12345         # force-kill PID 12345

${C_BOLD}ENV${C_RESET}
  NO_COLOR=1                Disable ANSI colors.

EOF
}

cmd_version() {
  echo "lps v$VERSION"
}

# ---------- main ----------

main() {
  local sub="${1:-list}"
  case "$sub" in
    list|ls|"") cmd_list ;;
    orphans|ghost|ghosts) cmd_orphans ;;
    kill|k) shift; cmd_kill "$@" ;;
    version|-v|--version) cmd_version ;;
    help|-h|--help) cmd_help ;;
    *)
      echo "${C_RED}Unknown command: $sub${C_RESET}" >&2
      echo "Run 'lps help' for usage." >&2
      exit 2
      ;;
  esac
}

main "$@"
